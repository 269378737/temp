<div id="results-interpretation" tal:condition="python:view.available()" tal:define="panels python:view.get_panels"
	i18n:domain="senaite.core">

	<!-- title and icon -->
	<h3 tal:define="icon view/icon_name|nothing;
                  title view/title|nothing" tal:condition="title">
		<img tal:condition="icon|nothing" tal:attributes="src string:senaite_theme/icon/${icon}" />
		<span i18n:translate="" tal:content="title" />
	</h3>

	<!-- Readonly Resultsinterpretation Field -->
	<tal:readonly tal:define="fieldName string:ResultsInterpretationDepts"
		tal:condition="python:not view.is_edit_allowed()">

		<div class="resultsinterpretations">

			<!-- General Results Interpretation -->
			<tal:general>
				<table class="table-borderless w-100" tal:define="text python:view.get_text(None, 'raw')">
					<tr>
						<th i18n:translate="">General</th>
					</tr>
					<tr>
						<td tal:content="structure python:text or default" />
					</tr>
				</table>
			</tal:general>

			<tal:panel repeat="panel panels">
				<table class="table-borderless w-100" tal:define="text python:view.get_text(panel, 'raw')">
					<tr>
						<th tal:content="panel/Title" />
					</tr>
					<tr>
						<td tal:content="structure python:text or default" />
					</tr>
				</table>
			</tal:panel>

		</div>
	</tal:readonly>


	<!-- Editable Resultsinterpretation Field -->
	<tal:edit tal:define="fieldName string:ResultsInterpretationDepts" tal:condition="python:view.is_edit_allowed()">

		<form class="form" name="arresultsinterpretation_form" action="." tal:attributes="action here/absolute_url"
			enctype="multipart/form-data" method="POST">

			<input type="hidden" name="submitted" value="1" />
			<input tal:replace="structure context/@@authenticator/authenticator" />

			<!-- Interpretation templates selector -->
			<div
				class="input-group input-group-sm flex-nowrap d-inline-flex w-auto mb-3 arinterpretationtemplates-selector">
				<div class="input-group-prepend">
					<span class="input-group-text" i18n:translate="">
						Template
					</span>
				</div>
				<select id="interpretationtemplate" name="interpretationtemplate" class="custom-select">
					<option value="" i18n:translate="">Select template</option>
					<tal:itemplates repeat="template view/get_interpretation_templates">
						<option tal:attributes="value template/uid" tal:content="template/title" />
					</tal:itemplates>
				</select>
				<!-- Template insert button -->
				<div class="input-group-append">
					<button id="interpretationtemplate-insert" name="interpretationtemplate-insert" type="submit"
						class="btn btn-outline-primary btn-sm" i18n:translate="">
						Use Template
					</button>
				</div>
			</div>

			<div class="arresultsinterpretation-container mb-2">
				<!-- Tabs for panels (departments) -->
				<ul class="nav nav-tabs" roles="tablist">
					<li class="nav-item">
						<a class="nav-link active" data-toggle="tab" href="#" role="tab" id="general" tal:attributes="href string:#${fieldName}-general;
                      data-uid string:${fieldName}-general;" i18n:translate="">General</a>

						<!-- <a class="nav-link active"
              data-toggle="tab"
              href="#"
              role="tab"
              id="general"
              tal:attributes="href string:#${fieldName}-general;
                    data-uid string:${fieldName}-general;"
              style="display: flex; align-items:center"
              ><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="#19c37d" d="M22.282 9.821a5.985 5.985 0 0 0-.516-4.91a6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.985 5.985 0 0 0-3.998 2.9a6.046 6.046 0 0 0 .743 7.097a5.98 5.98 0 0 0 .51 4.911a6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206a5.99 5.99 0 0 0 3.997-2.9a6.056 6.056 0 0 0-.747-7.073M13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081l4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494M3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085l4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646M2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.677l5.815 3.354l-2.02 1.168a.076.076 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.872zm16.597 3.855l-5.833-3.387L15.119 7.2a.076.076 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.407-.667m2.01-3.023l-.141-.085l-4.774-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135l-2.02-1.164a.08.08 0 0 1-.038-.057V6.075a4.5 4.5 0 0 1 7.375-3.453l-.142.08L8.704 5.46a.795.795 0 0 0-.393.681zm1.097-2.365l2.602-1.5l2.607 1.5v2.999l-2.597 1.5l-2.607-1.5Z"/></svg>&nbsp;&nbsp;AI</a> -->
					</li>
					<tal:panels repeat="panel panels">
						<li class="nav-item">
							<a class="nav-link" data-toggle="tab" href="#" role="tab" tal:attributes="id panel/Title;
                        href string:#${fieldName}-${panel/UID};
                        data-uid python:fieldName+'-'+panel.UID();">
								<span tal:content="panel/Title"></span>
								<button class="ai-intepretation-btn" type="button"
									style="border: 1px solid #ccc;background: transparent;padding-bottom: 4px;border-radius: 8px;margin-left: 5px; display: none">
									<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24">
										<path fill="#19c37d"
											d="M22.282 9.821a5.985 5.985 0 0 0-.516-4.91a6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.985 5.985 0 0 0-3.998 2.9a6.046 6.046 0 0 0 .743 7.097a5.98 5.98 0 0 0 .51 4.911a6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206a5.99 5.99 0 0 0 3.997-2.9a6.056 6.056 0 0 0-.747-7.073M13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081l4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494M3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085l4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646M2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.677l5.815 3.354l-2.02 1.168a.076.076 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.872zm16.597 3.855l-5.833-3.387L15.119 7.2a.076.076 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.407-.667m2.01-3.023l-.141-.085l-4.774-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135l-2.02-1.164a.08.08 0 0 1-.038-.057V6.075a4.5 4.5 0 0 1 7.375-3.453l-.142.08L8.704 5.46a.795.795 0 0 0-.393.681zm1.097-2.365l2.602-1.5l2.607 1.5v2.999l-2.597 1.5l-2.607-1.5Z" />
									</svg>
								</button>
							</a>


						</li>
					</tal:panels>
				</ul>

				<!-- TextAreas (RichText) for results interpretation -->
				<div class="tab-content p-2 border-left border-bottom border-right">
					<div class="tab-pane fade show active" role="tabpanel"
						tal:attributes="id string:${fieldName}-general;">
						<input type="hidden" tal:attributes="name string:${fieldName}.uid:records:ignore_empty;
                         id string:${fieldName}-uid-0;
                         value string:general;" />
						<textarea class="my-2 mce_editable" tal:attributes="name string:${fieldName}.richtext:records:ignore_empty;
                             id string:${fieldName}-richtext-0;" tal:content="python: view.get_text(None, 'raw')">
            </textarea>
					</div>

					<tal:panel repeat="panel panels">
						<div class="tab-pane fade" role="tabpanel" tal:define="uid panel/UID"
							tal:attributes="id string:${fieldName}-${uid};">
							<input type="hidden" tal:attributes="name string:${fieldName}.uid:records:ignore_empty;
                           id string:${fieldName}-uid-${repeat/panel/number};
                           value string:${uid};" />
							<textarea class="my-2 mce_editable" tal:attributes="name string:${fieldName}.richtext:records:ignore_empty;
                               id string:${fieldName}-richtext-${repeat/panel/number};"
								tal:content="python:view.get_text(panel, 'raw')">
              </textarea>
						</div>
					</tal:panel>
				</div>
			</div>
			<button type="submit" class="btn btn-primary btn-sm" i18n:translate="">Save</button>
		</form>
	</tal:edit>

	<script>
		window.onload = function () {
			var base_url = location.origin + '/' + location.pathname.split('/')[1];
			var gender = $("#Sex").val();

			var aiTimer = setInterval(function () {
				var aiModelDoms = $('[category="AI Coach"][uid]:not([uid="undefined"])');
				console.log('AI DOM: ', aiModelDoms)
				if (aiModelDoms.length != 0) {
					clearInterval(aiTimer);

					// 获取样本的套餐关键字
					var profilesTitle = [];
					var profilesId = $("#Profiles textarea").val().split("\n");
					profilesId.forEach((prifileId) => {
						var profileUrl = base_url + '/@@API/senaite/v1/' + prifileId;
						$.ajax({
							url: profileUrl,
							async: false,
							cache: false,
							success: function (profiles) {
								console.log('完整检测项目套餐数据', profiles)

								// 因王玉真账号获取到的套餐数据没有profile_key字段，故要么获取profile_key，要么获取getProfileKey
								if (profiles.profile_key) {
									profilesTitle.push(profiles.profile_key.split('-')[0]);
								} else if (profiles.getProfileKey) {
									profilesTitle.push(profiles.getProfileKey.split('-')[0]);
								}
							},
							error: function (xhr, status, err) {
								console.log('出错了：', status, err);
							},
						});
					})


					var interpretations = (window.interpretations = {});
					var suffix = ''

					Array.from(aiModelDoms).forEach((tr) => {
						var aiModelUID = $(tr).attr('uid');
						var url = base_url + '/@@API/senaite/v1/analysis/' + aiModelUID;
						$.ajax({
							url: url,
							async: false,
							cache: false,
							success: function (res) {
								if (res.items.length > 0) {
									var interimFields = res.items[0].InterimFields;
									var aiIntepretationResult = interimFields.find((o) => o.keyword === 'Json');
									var aiJson = JSON.parse(aiIntepretationResult.value);

									console.log(profilesTitle, aiJson);

									var interpretation = '';
									if (aiJson.CD) {
										// 新版模型智能解读
										if (profilesTitle.includes('MetaGuardAgingAI')) {
											// 生物年龄量化评估报告
											interpretation = '<div id="comprehensive-explanation" style=" background-color: #003cd0; color: #cddcf4; padding: 8px; font-size: 16px; font-weight: bold;text-align: center; border-radius: 8px;">健康评估综合说明</div>' + '<div style="background-color: #d7d8d8; padding: 6px 12px 12px 12px; border-radius: 12px; font-size: 10px; line-height: 16px; margin-top: 10px;">' + aiJson.CD + '</div>' + '<div id="specific-suggestions" style=" background-color: #003cd0; color: #cddcf4; padding: 8px; font-size: 16px; font-weight: bold; text-align: center; border-radius: 8px; margin: 20px 0 10px 0;">个性化健康管理建议</div>' + '<div id="suggestion-sub-title" style="line-height: 20px; font-size: 16px"><strong style="color: #0c3475;">针对您的代谢稳态和抗衰老目标，以下是为您定制的专属建议：</strong></div>' + '<div id="DNP" style="padding-top: 20px;"><div style="color: #0c3475;font-weight: bold; font-size:14px"><img style="width: 30px; display: inline-block; margin-right: 20px;" src="++plone++senaite.impress.static/cdn/reports/meta-guard-aging-ai/2.0.0/food.png" />饮食营养方案</div>' + '<div style="background-color: #d7d8d8; padding: 6px 12px 12px 12px; border-radius: 12px; font-size: 10px; line-height: 16px; margin-top: 10px;">' + aiJson.DNP + '</div></div>' + '<div id="NSP" style="padding-top: 20px;"><div style="color: #0c3475;font-weight: bold; font-size:14px"><img style="width: 30px; display: inline-block; margin-right: 20px;" src="++plone++senaite.impress.static/cdn/reports/meta-guard-aging-ai/2.0.0/vitamin.png" />营养素补充方案</div>' + '<div style="background-color: #d7d8d8; padding: 6px 12px 12px 12px; border-radius: 12px; font-size: 10px; line-height: 16px; margin-top: 10px;">' + aiJson.NSP + '</div></div>' + '<div id="ERP" style="padding-top: 20px;"><div style="color: #0c3475;font-weight: bold; font-size:14px"><img style="width: 74px; display: inline-block; margin-left: -20px;" src="++plone++senaite.impress.static/cdn/reports/meta-guard-aging-ai/2.0.0/sport.png" />运动调节方案</div>' + '<div style="background-color: #d7d8d8; padding: 6px 12px 12px 12px; border-radius: 12px; font-size: 10px; line-height: 16px; margin-top: 10px;">' + aiJson.ERP + '</div></div>' + '<div id="LIP" style="padding-top: 20px;"><div style="color: #0c3475;font-weight: bold; font-size:14px"><img style="width: 30px; display: inline-block; margin-right: 20px;" src="++plone++senaite.impress.static/cdn/reports/meta-guard-aging-ai/2.0.0/sleep.png" />生活方式方案</div>' + '<div style="background-color: #d7d8d8; padding: 6px 12px 12px 12px; border-radius: 12px; font-size: 10px; line-height: 16px; margin-top: 10px;">' + aiJson.LIP + '</div></div>' + '<p id="remark" style="margin-top: 6px; font-size: 10px;">*以上建议基于科学研究和对于老化过程中代谢变化的了解，旨在透过改进生活习惯来提高生理功能和延缓衰老。实施这些建议时，应考虑客户的个人偏好和条件，并在专业医疗人员的监督下进行调整，以确保其安全有效。</p>';
										} else if (profilesTitle.includes('MetaGuardAgingAISGP')) {
											// 时光派生物年龄量化评估报告
											interpretation = '<div id="DNP"><div style="background-color: #193B88; color: #fff; padding: 8px; font-size: 16px; font-weight: bold; text-align: center; border-radius: 32px;">饮食营养方案</div>' + '<div style="padding: 6px 12px 12px 12px; border-radius: 12px; font-size: 10px; line-height: 16px; margin-top: 10px;"><div style="display: inline-block; vertical-align: top; width: 8%;"><img style="width: 50px; display: inline-block; margin-right: 20px;" src="/++plone++senaite.impress.static/cdn/reports/meta-guard-aging-ai/2.0.0/food.png" /></div>' + '<div style="display: inline-block; vertical-align: top; background-color: #F2F2F2; width: 88%; margin-left: 15px; border-radius: 12px; padding: 10px 16px; text-align: justify;">' + aiJson.DNP + '</div></div></div>' + '<div id="ERP"><div style="background-color: #193B88; color: #fff; padding: 8px; font-size: 16px; font-weight: bold; text-align: center; border-radius: 32px;">运动调节方案</div>' + '<div style="padding: 6px 12px 12px 12px; border-radius: 12px; font-size: 10px; line-height: 16px; margin-top: 10px;"><div style="display: inline-block; vertical-align: top; width: 8%;"><img style="width: 100px; transform: scale(2) translateY(5px);" src="/++plone++senaite.impress.static/cdn/reports/meta-guard-aging-ai/2.0.0/sport.png" /></div>' + '<div style="display: inline-block; vertical-align: top; background-color: #F2F2F2; width: 88%; margin-left: 15px; border-radius: 12px;padding: 10px 16px; text-align: justify;">' + aiJson.ERP + '</div></div></div>' + '<div id="LIP"><div style="background-color: #193B88; color: #fff; padding: 8px; font-size: 16px; font-weight: bold; text-align: center; border-radius: 32px;">生活方式方案</div>' + '<div style="padding: 6px 12px 12px 12px; border-radius: 12px; font-size: 10px; line-height: 16px; margin-top: 10px;"><div style="display: inline-block; vertical-align: top; width: 8%;"><img style="width: 50px; display: inline-block; margin-right: 20px;" src="/++plone++senaite.impress.static/cdn/reports/meta-guard-aging-ai/2.0.0/sleep.png" /></div>' + '<div style="display: inline-block; vertical-align: top; background-color: #F2F2F2; width: 88%; margin-left: 15px; border-radius: 12px;padding: 10px 16px;text-align: justify;">' + aiJson.LIP + '</div></div></div>' + '<div id="NSP"><div style="background-color: #193B88; color: #fff; padding: 8px; font-size: 16px; font-weight: bold; text-align: center; border-radius: 32px;">营养素补充方案</div>' + '<div style="padding: 6px 12px 12px 12px; border-radius: 12px; font-size: 10px; line-height: 16px; margin-top: 10px;"><div style="display: inline-block; vertical-align: top; width: 8%;"><img style="width: 50px; display: inline-block; margin-right: 20px;" src="/++plone++senaite.impress.static/cdn/reports/meta-guard-aging-ai/2.0.0/vitamin.png" /></div>' + '<div style="display: inline-block; vertical-align: top; background-color: #F2F2F2; width: 88%; margin-left: 15px; border-radius: 12px;padding: 10px 16px;text-align: justify;"> ' + aiJson.NSP + '</div></div></div>' + '<p id="remark" style="margin-top: 6px; font-size: 10px;">*以上建议基于科学研究和对于老化过程中代谢变化的了解，旨在透过改进生活习惯来提高生理功能和延缓衰老。实施这些建议时，应考虑客户的个人偏好和条件，并在专业医疗人员的监督下进行调整，以确保其安全有效。</p>';
										} else if (profilesTitle.includes('MetaGuardCNEN')) {
											interpretation = '<p id="comprehensive-explanation" style="padding-bottom: 20px;"><strong style="color: #0c3475; font-size: 18px;">Comprehensive Description</strong></p><div style="border-radius: 20px; padding: 10px; background-color: rgba(244, 245, 251, 0.45); line-height: 20px;">' + '<p>' + aiJson.CD + '</p></div><p id="specific-suggestions" style="padding-bottom: 10px; padding-top: 20px;"><strong style="color: #0c3475; font-size: 18px;">Speciﬁc Suggestions</strong></p> ' + '<div id="suggestion-sub-title" style="padding-bottom:10px;line-height: 20px;"><strong style="color: #0c3475;">Based on your MetaGuard results, here is a personalized plan designed to optimize your metabolic stability and anti-aging goals,supported by the latest scientific evidence:</strong></div>' + '<div id="DNP" style="background-color: rgba(244, 245, 251, 0.45); padding: 10px; line-height: 20px;"><p><strong style="color: #0c3475;">Dietary and Nutritional Plan:</strong></p>' + aiJson.DNP + '</div>' + '<div id="NSP" style="background-color: rgba(244, 245, 251, 0.45); padding: 10px; line-height: 20px;"><p><strong style="color: #0c3475;">Nutrient Supplementation Plan:</strong></p>' + aiJson.NSP + '</div>' + '<div id="ERP" style="background-color: rgba(244, 245, 251, 0.45); padding: 10px; line-height: 20px;"><p><strong style="color: #0c3475;">Exercise Regulation Plan:</strong></p>' + aiJson.ERP + '</div>' + '<div id="LIP" style="background-color: rgba(244, 245, 251, 0.45); padding: 10px; line-height: 20px;"><p><strong style="color: #0c3475;">Lifestyle Plan:</strong></p>' + aiJson.LIP + '</div>' + '<p id="remark" style="padding: 0 10px; padding-top: 20px; line-height:18px;">*These recommendations are based on scientific research and an understanding of metabolic changes during the aging process, aimed at improving physiological functions and reducing the risk of chronic diseases.When implementing these recommendations, consider the client&apos;s personal preferences and conditions, and make adjustments under the supervision of Healthcare Professionals to ensure their safety and effectiveness.</p>';
										} else {
